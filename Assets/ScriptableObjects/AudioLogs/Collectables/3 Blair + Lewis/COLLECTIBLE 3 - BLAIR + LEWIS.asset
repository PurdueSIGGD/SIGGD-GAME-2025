  m_Script: {fileID: 11500000, guid: e17b972750c34bd4b903f60c7caf8be2, type: 3}
  m_Name: COLLECTIBLE 3 - BLAIR + LEWIS
  m_EditorClassIdentifier: 
  subtitles:
  - line: "\u2026"
    seconds: 6.806
    isFromRadio: 1
    isIntoRadio: 0
  - line: Are you recording this, Lewis?
    seconds: 9.077
    isFromRadio: 1
    isIntoRadio: 0
  - line: "Right as. They don\u2019t want us recording music on these, but\u2026"
    seconds: 12.806
    isFromRadio: 1
    isIntoRadio: 0
  - line: "I\u2019m fighting the man."
    seconds: 17.455
    isFromRadio: 1
    isIntoRadio: 0
  - line: "\u2018The man\u2019 isn\u2019t stopping you from whistling."
    seconds: 19.832
    isFromRadio: 1
    isIntoRadio: 0
  - line: "And, in fact, you should thank \u2018the man\u2019 for giving you a job
      on this ship."
    seconds: 23.857
    isFromRadio: 1
    isIntoRadio: 0
  - line: "But imagine if there were no man to \u2018give\u2019 jobs.  Ever think
      about that?"
    seconds: 30.223
    isFromRadio: 1
    isIntoRadio: 0
  - line: "[Moment of silence] \u201C\u2026"
    seconds: 32.216
    isFromRadio: 1
    isIntoRadio: 0
  - line: "I don\u2019t get it."
    seconds: 33.545
    isFromRadio: 1
    isIntoRadio: 0
  - line: "Think about it like this. \u2018The man\u2019 gave you a federation job,
      right?"
    seconds: 38.412
    isFromRadio: 1
    isIntoRadio: 0
  - line: "But if there were no \u2018man\u2019\u2014or woman, either\u2014there
      wouldn\u2019t need to be a federation."
    seconds: 44.505
    isFromRadio: 1
    isIntoRadio: 0
  - line: "So\u2026 I wouldn\u2019t have a job? Speak for yourself; we can\u2019t
      all be \u2018musicians\u2019."
    seconds: 50.176
    isFromRadio: 1
    isIntoRadio: 0
  - line: "Just you wait. Soon enough, there won\u2019t even be a ship to guard."
    seconds: 54.545
    isFromRadio: 1
    isIntoRadio: 0
  - line: "Why, you\u2019re going to blow up the man yourself?"
    seconds: 57.651
    isFromRadio: 1
    isIntoRadio: 0
  - line: "C\u2019mon, Blair, don\u2019t be silly. The man\u2019s a concept. How
      could I fight a concept?"
    seconds: 62.248
    isFromRadio: 1
    isIntoRadio: 0
  - line: "I mean, how are you supposed to blow up something that doesn\u2019t exist?"
    seconds: 65.097
    isFromRadio: 1
    isIntoRadio: 0
  - line: "I\u2019m going to take the captain\u2019s lunch from the freezer."
    seconds: 68.263
    isFromRadio: 1
    isIntoRadio: 0
  audioName: COLLECTIBLE 3 - BLAIR + LEWIS
