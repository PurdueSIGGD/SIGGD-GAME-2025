  m_Script: {fileID: 11500000, guid: e17b972750c34bd4b903f60c7caf8be2, type: 3}
  m_Name: "COLLECTIBLE 12 - Ren\xE9e"
  m_EditorClassIdentifier: 
  subtitles:
  - line: "Officer Ren\xE9e, medical staff report, number 1-04-1459."
    seconds: 5.279
    isFromRadio: 1
    isIntoRadio: 0
  - line: Patient was admitted to in-unit burn care this morning after an accident
      in the engine room.
    seconds: 9.688
    isFromRadio: 1
    isIntoRadio: 0
  - line: "Consistent with initial reports, epidermis of the left\u2014"
    seconds: 14.268
    isFromRadio: 1
    isIntoRadio: 0
  - line: You doing all right in there, hon?
    seconds: 15.665
    isFromRadio: 1
    isIntoRadio: 0
  - line: "\u2026"
    seconds: 18.056
    isFromRadio: 1
    isIntoRadio: 0
  - line: Epidermis of the left thumb is carbonized, subdermis exposed.  Second degree
      burns along the whole proximal phalanx.
    seconds: 26.347
    isFromRadio: 1
    isIntoRadio: 0
  - line: During the incident, the welding apparatus which caused the lesion
    seconds: 29.802
    isFromRadio: 1
    isIntoRadio: 0
  - line: was operating hot enough to cauterize the flesh, so the patient is not
      at immediate risk of infection.
    seconds: 35.927
    isFromRadio: 1
    isIntoRadio: 0
  - line: Thumb is immobilized; patient should recover full use in two to three weeks.
    seconds: 40.826
    isFromRadio: 1
    isIntoRadio: 0
  - line: Submitting report to senior staff for further action.
    seconds: 43.717
    isFromRadio: 1
    isIntoRadio: 0
  - line: "\u2026"
    seconds: 46.845
    isFromRadio: 1
    isIntoRadio: 0
  - line: "Now, hon, if last time wasn\u2019t enough of a reminder to wear those
      gloves, maybe it\u2019s best if I get your supervisor to come talk with you
      again, hm?"
    seconds: 55.86
    isFromRadio: 1
    isIntoRadio: 0
  - line: "Oop, forgot t\u2014"
    seconds: 56.609
    isFromRadio: 1
    isIntoRadio: 0
  audioName: "COLLECTIBLE 12 - Ren\xE9e"
