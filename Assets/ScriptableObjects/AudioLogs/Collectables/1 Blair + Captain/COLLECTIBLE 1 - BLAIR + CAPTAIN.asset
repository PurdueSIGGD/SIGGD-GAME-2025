  m_Script: {fileID: 11500000, guid: e17b972750c34bd4b903f60c7caf8be2, type: 3}
  m_Name: COLLECTIBLE 1 - BLAIR + CAPTAIN
  m_EditorClassIdentifier: 
  subtitles:
  - line: "\u2014es Ma\u2019am, starting log."
    seconds: 1.504
    isFromRadio: 1
    isIntoRadio: 0
  - line: Ahem. Thirty-two days since the SCS Pandora left port, time 10:15.
    seconds: 8.19
    isFromRadio: 1
    isIntoRadio: 0
  - line: 'Mission status: good, readings from cargo are within predicted limits. 
      Crew are well; no incidents.'
    seconds: 15.489
    isFromRadio: 1
    isIntoRadio: 0
  - line: "That\u2019s all, end log."
    seconds: 17.731
    isFromRadio: 1
    isIntoRadio: 0
  - line: "Yes, M\u2014"
    seconds: 18.367
    isFromRadio: 1
    isIntoRadio: 0
  - line: "\u2026"
    seconds: 22.162
    isFromRadio: 1
    isIntoRadio: 0
  - line: "\u2014rting log."
    seconds: 23.196
    isFromRadio: 1
    isIntoRadio: 0
  - line: 'Forty-nine days into mission, time 10:15. Mission status: good.'
    seconds: 29.058
    isFromRadio: 1
    isIntoRadio: 0
  - line: "Cargo is secure and within limits. Crew \u2026 any incidents today?"
    seconds: 35.155
    isFromRadio: 1
    isIntoRadio: 0
  - line: Hal from engineering got his thumb burnt on the arc welder again.
    seconds: 38.629
    isFromRadio: 1
    isIntoRadio: 0
  - line: Different thumb than last time?
    seconds: 40.58
    isFromRadio: 1
    isIntoRadio: 0
  - line: "No, Ma\u2019am, same one."
    seconds: 42.602
    isFromRadio: 1
    isIntoRadio: 0
  - line: Crew able to perform duties, but incur unnecessary risk.
    seconds: 47.224
    isFromRadio: 1
    isIntoRadio: 0
  - line: Will impose additional safety training.  End log.
    seconds: 50.689
    isFromRadio: 1
    isIntoRadio: 0
  - line: "Yes, Ma\u2019am."
    seconds: 51.36
    isFromRadio: 1
    isIntoRadio: 0
  - line: "\u2026"
    seconds: 53.915
    isFromRadio: 1
    isIntoRadio: 0
  - line: "\u2014og is ready, captain."
    seconds: 55.7
    isFromRadio: 1
    isIntoRadio: 0
  - line: "Sixty-three days since mission start. Pandora\u2019s cargo readings fluctuating,
      have directed engineers to look into it."
    seconds: 63.143
    isFromRadio: 1
    isIntoRadio: 0
  - line: Structural integrity is fine [*] and crew is in order.
    seconds: 67.203
    isFromRadio: 1
    isIntoRadio: 0
  - line: Private Hal is still recovering in the med bay.  Ensign, what is that alarm?
    seconds: 71.731
    isFromRadio: 1
    isIntoRadio: 0
  - line: "We\u2019re getting some voltage spikes on the failsafe grid."
    seconds: 74.291
    isFromRadio: 1
    isIntoRadio: 0
  - line: "Not sure why; there shouldn\u2019t be any draw."
    seconds: 76.862
    isFromRadio: 1
    isIntoRadio: 0
  - line: Are they monitoring this in the engine room?
    seconds: 79.286
    isFromRadio: 1
    isIntoRadio: 0
  - line: "Yes, Ma\u2019am.  Same readings."
    seconds: 81.063
    isFromRadio: 1
    isIntoRadio: 0
  - line: "[Tense] \u201CI knew that thing would bring bad luck with it. Get that
      log off, now."
    seconds: 85.452
    isFromRadio: 1
    isIntoRadio: 0
  - line: "Yes, Ma\u2019\u2014"
    seconds: 86.039
    isFromRadio: 1
    isIntoRadio: 0
  audioName: COLLECTIBLE 1 - BLAIR + CAPTAIN
