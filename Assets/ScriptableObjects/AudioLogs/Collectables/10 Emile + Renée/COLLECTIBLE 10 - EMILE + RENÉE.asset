  m_Name: "COLLECTIBLE 10 - EMILE + REN\xC9E"
  m_EditorClassIdentifier: 
  subtitles:
  - line: Okay. Recording on. Sanitation crew Emile.
    seconds: 2.931
    isFromRadio: 1
    isIntoRadio: 0
  - line: "I\u2019m going over the hazardous materials that just came in."
    seconds: 5.54
    isFromRadio: 1
    isIntoRadio: 0
  - line: "And I\u2019m Medical Officer Ren\xE9e cataloguing them."
    seconds: 9.096
    isFromRadio: 1
    isIntoRadio: 0
  - line: "Alright. First we\u2019ve got the usual stuff, PPE, waste bags."
    seconds: 12.725
    isFromRadio: 1
    isIntoRadio: 0
  - line: Here you go.
    seconds: 14.783
    isFromRadio: 1
    isIntoRadio: 0
  - line: Done.
    seconds: 16.17
    isFromRadio: 1
    isIntoRadio: 0
  - line: "Next we\u2019ve got three 5 milliliter bottles of\u2026"
    seconds: 19.414
    isFromRadio: 1
    isIntoRadio: 0
  - line: We had a spill in the lab; these are replacements. Done.
    seconds: 25.827
    isFromRadio: 1
    isIntoRadio: 0
  - line: "Alright. Ten milliliter bottle of\u2026 bormoracil-5?"
    seconds: 29.842
    isFromRadio: 1
    isIntoRadio: 0
  - line: "Let me see that. Bromouracil-5. That\u2019s\u2014OK, done."
    seconds: 36.227
    isFromRadio: 1
    isIntoRadio: 0
  - line: 'Right, right. Burmuracil. Next up: tank of reactive octane.'
    seconds: 40.692
    isFromRadio: 1
    isIntoRadio: 0
  - line: "Oxygen, hon. I\u2019m\u2014mm-hmm, done, done."
    seconds: 45.948
    isFromRadio: 1
    isIntoRadio: 0
  - line: "Sorry. OK, last up is 5 milliliters of m\u2026 methyl\u2026 methyloni\u2026"
    seconds: 52.728
    isFromRadio: 1
    isIntoRadio: 0
  - line: "lither\u2026 methylithereo\u2026"
    seconds: 55.668
    isFromRadio: 1
    isIntoRadio: 0
  - line: "Take your time. I\u2019m turning the recording off."
    seconds: 59.61
    isFromRadio: 1
    isIntoRadio: 0
  audioName: "COLLECTIBLE 10 - EMILE + REN\xC9E"
