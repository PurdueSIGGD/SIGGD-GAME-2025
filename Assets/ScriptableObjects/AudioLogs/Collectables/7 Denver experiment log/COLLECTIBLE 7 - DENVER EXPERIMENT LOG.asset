  m_Name: COLLECTIBLE 7 - DENVER EXPERIMENT LOG
  m_EditorClassIdentifier: 
  subtitles:
  - line: Science Officer Denver recording log. Experiment 19G.
    seconds: 5.474
    isFromRadio: 1
    isIntoRadio: 0
  - line: "Subject ID: \u2018Deimos\u2019 84-99-88-107-83."
    seconds: 11.067
    isFromRadio: 1
    isIntoRadio: 0
  - line: 'Current status: Internal organs remain intact.'
    seconds: 14.551
    isFromRadio: 1
    isIntoRadio: 0
  - line: Unrecoverable tissues make up 83.47% of the total volume.
    seconds: 21.055
    isFromRadio: 1
    isIntoRadio: 0
  - line: "Applying current\u2026"
    seconds: 23.217
    isFromRadio: 1
    isIntoRadio: 0
  - line: "[minor pause] \u201C\u2026"
    seconds: 25.556
    isFromRadio: 1
    isIntoRadio: 0
  - line: 'Electric stimulus successful: gangrenous areas have been consumed by surrounding
      tissues.'
    seconds: 31.302
    isFromRadio: 1
    isIntoRadio: 0
  - line: Signs of brain function have returned and spiked intensely in the pain
      neuromatrix,
    seconds: 36.449
    isFromRadio: 1
    isIntoRadio: 0
  - line: as well as in the superior temporal cortex.
    seconds: 40.409
    isFromRadio: 1
    isIntoRadio: 0
  - line: Organs are seizing and have begun receding into the rib cage.
    seconds: 43.841
    isFromRadio: 1
    isIntoRadio: 0
  - line: The skin is beginning to heal as usual, although at an apparently reduced
      rate.
    seconds: 48.754
    isFromRadio: 1
    isIntoRadio: 0
  - line: "40 months clearly aren\u2019t enough for full impairment; life support
      measures remain unnecessary."
    seconds: 55.024
    isFromRadio: 1
    isIntoRadio: 0
  - line: End log.
    seconds: 55.958
    isFromRadio: 1
    isIntoRadio: 0
  audioName: COLLECTIBLE 7 - DENVER EXPERIMENT LOG
