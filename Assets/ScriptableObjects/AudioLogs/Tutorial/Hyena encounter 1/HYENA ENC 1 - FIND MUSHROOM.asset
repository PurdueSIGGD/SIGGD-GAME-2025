  m_Script: {fileID: 11500000, guid: e17b972750c34bd4b903f60c7caf8be2, type: 3}
  m_Name: HYENA ENC 1 - FIND MUSHROOM
  m_EditorClassIdentifier: 
  subtitles:
  - line: The cap structure of this fungus is glowing!
    seconds: 3.867
    isFromRadio: 0
    isIntoRadio: 1
  - line: "Compared to the rest of the nearby flora, it\u2019s much larger and sturdier."
    seconds: 8.855
    isFromRadio: 0
    isIntoRadio: 1
  - line: "It\u2019s the first of its kind I\u2019ve seen so far."
    seconds: 12.91
    isFromRadio: 0
    isIntoRadio: 1
  - line: 'Log: Discovered a glowing fungal organism, tentatively calling it a mushroom.'
    seconds: 19.972
    isFromRadio: 0
    isIntoRadio: 1
  - line: Upon closer inspection, it seems to be connected to all the flora nearby.
    seconds: 25.408
    isFromRadio: 0
    isIntoRadio: 1
  - line: "It\u2019s odd how similar this is to fungi on Earth."
    seconds: 28.835
    isFromRadio: 0
    isIntoRadio: 1
  - line: Terrestrial mushrooms use their caps for spore distribution, but perhaps
      things are different on this planet.
    seconds: 35.807
    isFromRadio: 0
    isIntoRadio: 1
  - line: I would need a chance to study them more closely to draw definitive conclusions.
    seconds: 40.681
    isFromRadio: 0
    isIntoRadio: 1
  audioName: HYENA ENC 1 - FIND MUSHROOM
