  m_Script: {fileID: 11500000, guid: e17b972750c34bd4b903f60c7caf8be2, type: 3}
  m_Name: AXE - FOUND LOG IN LIFE POD
  m_EditorClassIdentifier: 
  subtitles:
  - line: "There\u2019s an audio log left on their radio, dated to 8 hours ago."
    seconds: 6.812
    isFromRadio: 0
    isIntoRadio: 0
  - line: Mayday, mayday! SCS Pandora experiencing fatal engine failure,
    seconds: 11.249
    isFromRadio: 1
    isIntoRadio: 0
  - line: "requesting immediate evac support to stellar octant\u2014"
    seconds: 14.147
    isFromRadio: 1
    isIntoRadio: 0
  - line: Shut up! We can get this under control.
    seconds: 16.374
    isFromRadio: 1
    isIntoRadio: 0
  - line: "Remember that this transport mission is top secret; we can\u2019t just
      broadcast our location."
    seconds: 20.498
    isFromRadio: 1
    isIntoRadio: 0
  - line: "But sir, even if we\u2014"
    seconds: 22.031
    isFromRadio: 1
    isIntoRadio: 0
  - line: Just get over here and help me!
    seconds: 24.299
    isFromRadio: 1
    isIntoRadio: 0
  - line: "So she didn\u2019t think the ship could be saved."
    seconds: 28.622
    isFromRadio: 0
    isIntoRadio: 0
  - line: No wonder the pod is so well-prepared for evacuation.
    seconds: 32.062
    isFromRadio: 0
    isIntoRadio: 0
  audioName: AXE - FOUND LOG IN LIFE POD
