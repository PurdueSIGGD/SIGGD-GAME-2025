  m_BlockName: Custom HLSL
  m_HLSLCode: "void CustomHLSL(inout VFXAttributes attributes, \n\t\t           in
    float changeDirectionChance, \n\t\t           in float randomVariable, \n\t\t\t
    in float speedFactor) {\n  if (randomVariable < changeDirectionChance) {\n   
